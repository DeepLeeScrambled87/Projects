{
  "name": "api-os",
  "version": "0.1.0",
  "private": true,
  "description": "API OS - Monorepo for API OS application",
  "type": "commonjs",
  "packageManager": "npm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "lint": "npm run lint -w apps/web",
    "lint:fix": "npm run lint:fix -w apps/web",
    "type-check": "npm run type-check -w apps/web",
    "clean": "npm run clean -w apps/web",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeepLeeScrambled87/Projects.git"
  },
  "bugs": {
    "url": "https://github.com/DeepLeeScrambled87/Projects/issues"
  },
  "homepage": "https://github.com/DeepLeeScrambled87/Projects#readme",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18.17.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.1.0",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.0",
    "@types/pg": "^8.16.0",
    "jest": "^30.2.0",
    "prisma": "^7.1.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
